# dependencies
node_modules/

# Expo
.expo/
dist/
web-build/
expo-env.d.ts

# Native
.kotlin/
*.orig.*
*.jks
*.p8
*.p12
*.key
*.mobileprovision
build/
.cxx/

# Release signing — never commit the keystore or its passwords, even privately.
# CI reads these from GitHub Actions secrets instead (see .github/workflows/release.yml).
/keystores/
keystore.properties

# Metro
.metro-health-check*

# debug
npm-debug.*
yarn-debug.*
yarn-error.*

# macOS
.DS_Store
*.pem

# local env files
.env*.local

# typescript
*.tsbuildinfo

# generated native folders
/ios
/android

# Claude Code session runtime state
.claude/scheduled_tasks.lock
