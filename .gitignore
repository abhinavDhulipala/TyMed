# Learn more https://docs.github.com/en/get-started/getting-started-with-git/ignoring-files

# Android / Gradle build output
build/
.cxx/
.gradle/
.kotlin/
local.properties
*.apk
*.aab

# Android Studio / IntelliJ
.idea/
*.iml

# Release signing — never commit the keystore or its passwords, even privately.
# CI reads these from GitHub Actions secrets instead (see .github/workflows/release.yml).
/keystores/
keystore.properties

# macOS
.DS_Store
*.pem
*.orig.*
*.jks
*.p8
*.p12
*.key
*.mobileprovision

# Claude Code session runtime state
.claude/scheduled_tasks.lock
